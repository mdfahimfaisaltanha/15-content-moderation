# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon/Supabase free tier works).
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Optional: OpenAI --------------------------------------------------------
# Leave blank to run the Stage-2 classifier in MOCK mode: a deterministic
# keyword-weighted classifier — the full two-stage pipeline, routing, review
# queue, and load test all work with zero API setup.
# Set a key to classify the ambiguous middle with gpt-4o-mini instead.
OPENAI_API_KEY=

# --- Routing thresholds (the risk dials) --------------------------------------
# Final score < AUTO_APPROVE_BELOW  -> approved automatically
# Final score > AUTO_REJECT_ABOVE   -> rejected automatically
# Anything in between              -> human review queue
AUTO_APPROVE_BELOW=25
AUTO_REJECT_ABOVE=80

# Password used for all seeded moderator accounts (optional).
SEED_PASSWORD=ChangeMe123!
